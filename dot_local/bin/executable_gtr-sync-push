#!/bin/bash
# 複数の git worktree (例: insight, insight-wt1, insight-wt2, ...) の作業内容を
# それぞれのディレクトリでコミットし、push をまとめて並行実行する。
#
# リポジトリ名を渡すと、そのリポジトリの `git worktree list` から
# 実在するワークツリーを自動検出し、各ディレクトリの中で
# git add / git commit / git push を並行に実行する。
#
# 使い方:
#   gtr-sync-push -m "<commit message>" <repo> [<repo> ...]
#   gtr-sync-push --no-commit <repo> [<repo> ...]   # push のみ
#
# オプション:
#   -m, --message <msg>   コミットメッセージ（--no-commit 指定時は不要）
#   --no-commit            コミットは行わず push のみ実行
#   --include-main         main/master ブランチのワークツリーも対象にする（既定は除外）
#   --dry-run              実際には実行せず、実行予定のコマンドのみ表示
#   -y, --yes              確認プロンプトをスキップ
#
# 例:
#   gtr-sync-push -m "wip: 実験結果を記録" insight
#   gtr-sync-push -m "fix: バリデーション修正" cryptotimes-candydrio affiliateMediaOs
#   gtr-sync-push --no-commit -y insight

set -u

WORKSPACE_ROOT="${GTR_WORKSPACE_ROOT:-$HOME/workspace/sibukixxx}"

# カラー出力
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log_info() { echo -e "${GREEN}[INFO]${NC} $1"; }
log_warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
log_error() { echo -e "${RED}[ERROR]${NC} $1"; }
log_section() { echo ""; echo -e "${CYAN}=== $1 ===${NC}"; }

usage() {
    cat <<EOF
使い方: $(basename "$0") [options] <repo> [<repo> ...]

オプション:
  -m, --message <msg>   コミットメッセージ（--no-commit 指定時は不要）
  --no-commit           コミットは行わず push のみ実行
  --include-main        main/master ブランチのワークツリーも対象にする（既定は除外）
  --dry-run             実際には実行せず、実行予定のコマンドのみ表示
  -y, --yes             確認プロンプトをスキップ
  -h, --help            このヘルプを表示

環境変数:
  GTR_WORKSPACE_ROOT    リポジトリを探すルートディレクトリ（既定: \$HOME/workspace/sibukixxx）

例:
  $(basename "$0") -m "wip: 実験結果を記録" insight
  $(basename "$0") -m "fix: バリデーション修正" cryptotimes-candydrio affiliateMediaOs
  $(basename "$0") --no-commit -y insight
EOF
}

MESSAGE=""
DO_COMMIT=true
INCLUDE_MAIN=false
DRY_RUN=false
ASSUME_YES=false
REPOS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -m|--message)
            MESSAGE="${2:-}"
            shift 2
            ;;
        --no-commit)
            DO_COMMIT=false
            shift
            ;;
        --include-main)
            INCLUDE_MAIN=true
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        -y|--yes)
            ASSUME_YES=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            log_error "不明なオプション: $1"
            usage
            exit 1
            ;;
        *)
            REPOS+=("$1")
            shift
            ;;
    esac
done

if [ ${#REPOS[@]} -eq 0 ]; then
    log_error "リポジトリ名を1つ以上指定してください"
    usage
    exit 1
fi

if [ "$DO_COMMIT" = true ] && [ -z "$MESSAGE" ]; then
    log_error "コミットメッセージを -m で指定してください（push のみなら --no-commit）"
    exit 1
fi

# 対象ワークツリーの収集: 「パス:ブランチ」の配列
TARGETS=()

for repo in "${REPOS[@]}"; do
    repo_path="$WORKSPACE_ROOT/$repo"

    if [ ! -d "$repo_path" ]; then
        log_error "リポジトリが見つかりません: $repo_path"
        continue
    fi

    if ! git -C "$repo_path" rev-parse --show-toplevel &>/dev/null; then
        log_error "git リポジトリではありません: $repo_path"
        continue
    fi

    while IFS= read -r wt_path; do
        [ -d "$wt_path" ] || continue

        branch=$(git -C "$wt_path" branch --show-current 2>/dev/null)
        if [ -z "$branch" ]; then
            log_warn "detached HEAD のためスキップ: $wt_path"
            continue
        fi

        if [[ "$branch" == "main" || "$branch" == "master" ]] && [ "$INCLUDE_MAIN" != true ]; then
            log_warn "main/master ブランチのためスキップ: $wt_path (--include-main で強制)"
            continue
        fi

        TARGETS+=("$wt_path:$branch")
    done < <(git -C "$repo_path" worktree list --porcelain | awk '/^worktree /{print $2}')
done

if [ ${#TARGETS[@]} -eq 0 ]; then
    log_error "対象になるワークツリーがありません"
    exit 1
fi

log_section "実行計画"
for target in "${TARGETS[@]}"; do
    path="${target%%:*}"
    branch="${target##*:}"
    echo "  $(basename "$path")  [$branch]  $path"
done
echo ""
if [ "$DO_COMMIT" = true ]; then
    echo "  コミットメッセージ: $MESSAGE"
else
    echo "  コミット: スキップ（push のみ）"
fi
[ "$DRY_RUN" = true ] && echo "  モード: dry-run（実行しません）"

if [ "$ASSUME_YES" != true ] && [ "$DRY_RUN" != true ]; then
    echo ""
    read -p "この内容で ${#TARGETS[@]} 件を並行実行しますか? (y/N): " REPLY
    if [[ ! "$REPLY" =~ ^[Yy]$ ]]; then
        log_info "中断しました"
        exit 0
    fi
fi

LOG_DIR=$(mktemp -d "${TMPDIR:-/tmp}/gtr-sync-push.XXXXXX")
trap 'rm -rf "$LOG_DIR"' EXIT

sync_one() {
    local path="$1" branch="$2" logfile="$3"
    {
        cd "$path" || { echo "[ERROR] ディレクトリに移動できません: $path"; exit 1; }

        echo "[branch] $branch"

        if [ "$DO_COMMIT" = true ]; then
            if [ -n "$(git status --porcelain)" ]; then
                if [ "$DRY_RUN" = true ]; then
                    echo "[DRY-RUN] git add -A && git commit -m \"$MESSAGE\""
                else
                    git add -A
                    git commit -m "$MESSAGE"
                fi
            else
                echo "[commit] 変更なし、スキップ"
            fi
        fi

        if [ "$DRY_RUN" = true ]; then
            echo "[DRY-RUN] git push (branch: $branch)"
            exit 0
        fi

        if git rev-parse --abbrev-ref --symbolic-full-name '@{u}' &>/dev/null; then
            git push
        else
            git push -u origin "$branch"
        fi
        echo "[push] 完了"
    } > "$logfile" 2>&1
}

log_section "並行実行中 (${#TARGETS[@]} 件)"

PIDS=()
LABELS=()

for target in "${TARGETS[@]}"; do
    path="${target%%:*}"
    branch="${target##*:}"
    label="$(basename "$path")"
    logfile="$LOG_DIR/$label.log"

    sync_one "$path" "$branch" "$logfile" &
    PIDS+=($!)
    LABELS+=("$label")
done

FAIL=0
for i in "${!PIDS[@]}"; do
    pid="${PIDS[$i]}"
    label="${LABELS[$i]}"

    if wait "$pid"; then
        status="${GREEN}OK${NC}"
    else
        status="${RED}NG${NC}"
        FAIL=1
    fi

    echo ""
    echo -e "${CYAN}--- $label ($(echo -e "$status"))${NC} ---"
    cat "$LOG_DIR/$label.log"
done

echo ""
if [ "$FAIL" -eq 1 ]; then
    log_error "一部のワークツリーでエラーが発生しました"
    exit 1
fi

log_info "すべて完了しました"
