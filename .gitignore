# Claude Code - ignore cache/history, keep config
.claude/*
!.claude/CLAUDE.md
!.claude/settings.json
!.claude/settings.local.json
!.claude/install.sh
!.claude/rules/
!.claude/agents/
!.claude/commands/
!.claude/hooks/
!.claude/skills/

# Codex - keep declarative configuration only. Runtime state, credentials,
# caches, plugin payloads, and session databases must never enter git.
.codex/*
!.codex/AGENTS.md
!.codex/config.default.toml
!.codex/hooks.json
!.codex/install.sh
!.codex/agents/
!.codex/hooks/
!.codex/rules/
!.codex/skills/
.codex/skills/.system/
.codex/**/__pycache__/
*.pyc

# AI rules - generated files are not tracked
ai-rules/generated/

# Local zsh runtime files (do not commit)
.zsh_history
.zsh_sessions/
