prefix_rule(pattern=["/bin/zsh", "-lc", "for pair in 'stg-ok https://cryptotimes-emdash-stg.shikiha25.workers.dev/feeds/ok-coin.xml' 'stg-gunosy https://cryptotimes-emdash-stg.shikiha25.workers.dev/feeds/gunosy.xml' 'stg-ntt https://cryptotimes-emdash-stg.shikiha25.workers.dev/feeds/ntt.xml' 'stg-obsidian https://cryptotimes-emdash-stg.shikiha25.workers.dev/feeds/obsidian.xml' 'stg-feed https://cryptotimes-emdash-stg.shikiha25.workers.dev/feed/' 'old-ok https://crypto-times.jp/?feed=ok_coin' 'old-gunosy https://crypto-times.jp/?feed=gunosy' 'old-ntt https://crypto-times.jp/?feed=ntt' 'old-obsidian https://crypto-times.jp/?feed=obsidian' 'old-feed https://crypto-times.jp/feed/'; do name=${pair%% *}; url=${pair#* }; wget -q --server-response -O \"/tmp/rss-$name.xml\" \"$url\" 2> \"/tmp/rss-$name.headers\" || true; response_code=$(awk '/^  HTTP\\// {s=$2} END {print s}' \"/tmp/rss-$name.headers\"); ctype=$(awk 'BEGIN{IGNORECASE=1} /^  Content-Type:/ {sub(/\\r$/,\"\"); print substr($0,17)}' \"/tmp/rss-$name.headers\" | tail -1); bytes=$(wc -c < \"/tmp/rss-$name.xml\" | tr -d ' '); printf '%s status=%s bytes=%s type=%s\\n' \"$name\" \"$response_code\" \"$bytes\" \"$ctype\"; done"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "for pair in 'old-ok https://crypto-times.jp/?feed=ok_coin' 'old-gunosy https://crypto-times.jp/?feed=gunosy' 'old-ntt https://crypto-times.jp/?feed=ntt' 'old-obsidian https://crypto-times.jp/?feed=obsidian' 'old-feed https://crypto-times.jp/feed/'; do name=${pair%% *}; url=${pair#* }; wget -q --timeout=15 --tries=1 --server-response -O \"/tmp/rss-$name.xml\" \"$url\" 2> \"/tmp/rss-$name.headers\" || true; response_code=$(awk '/^  HTTP\\// {s=$2} END {print s}' \"/tmp/rss-$name.headers\"); ctype=$(awk 'BEGIN{IGNORECASE=1} /^  Content-Type:/ {sub(/\\r$/,\"\"); print substr($0,17)}' \"/tmp/rss-$name.headers\" | tail -1); bytes=$(wc -c < \"/tmp/rss-$name.xml\" | tr -d ' '); printf '%s status=%s bytes=%s type=%s\\n' \"$name\" \"$response_code\" \"$bytes\" \"$ctype\"; done"], decision="allow")
