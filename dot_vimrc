" 最小限の Vim 設定
" 普段の編集は Neovim（zsh で vim は nvim の alias、設定は ~/.config/nvim/init.lua）。
" この ~/.vimrc は /usr/bin/vim が直接起動される場面（sudo vi、サーバー上の作業など）だけで読まれる。
set nocompatible
set backspace=indent,eol,start
set number
set hlsearch
set incsearch
set ignorecase
set smartcase
set autoread
set hidden
set noswapfile
set title
syntax enable
filetype plugin indent on
